{%- comment -%} Generated by scripts/make-guides.js. How-to and length guide photos shown under each product. {%- endcomment -%}
{%- case product.handle -%}
  {%- when "nano-ring-hair-extensions" -%}
    <figure><img src="{{ 'nano-ring-how-to-fit.jpg' | asset_url }}" alt="How to fit nano ring extensions, step by step" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">How to fit nano ring extensions, step by step</figcaption></figure>
    <figure><img src="{{ 'nano-ring-guide.jpg' | asset_url }}" alt="Texture, pack size and how many packs to choose" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">Texture, pack size and how many packs to choose</figcaption></figure>
  {%- when "tape-in-hair-extensions" -%}
    <figure><img src="{{ 'tape-in-length-guide.jpg' | asset_url }}" alt="Where each length falls, straight and curled" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">Where each length falls, straight and curled</figcaption></figure>
  {%- when "nano-ring-beads" -%}
    <figure><img src="{{ 'nano-beads-how-to.jpg' | asset_url }}" alt="How to fit a ring extension, step by step" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">How to fit a ring extension, step by step</figcaption></figure>
  {%- when "salon-comb-set" -%}
    <figure><img src="{{ 'comb-set-uses.jpg' | asset_url }}" alt="Picking up, sectioning and colouring with the tail combs" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">Picking up, sectioning and colouring with the tail combs</figcaption></figure>
  {%- when "steel-sectioning-clips" -%}
    <figure><img src="{{ 'clips-uses.jpg' | asset_url }}" alt="Clips in use for colouring, styling and braiding" loading="lazy" width="1000" height="1000"><figcaption class="colour-name">Clips in use for colouring, styling and braiding</figcaption></figure>
{%- endcase -%}
