<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:title" content="{{ page_title | escape }}">
{%- if page_description %}
<meta property="og:description" content="{{ page_description | escape }}">
{%- endif %}
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- else %}
<meta property="og:image" content="https:{{ 'og-image.png' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Nano ring hair extensions next to the Velvet Lengths logo">
{%- endif %}
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if page_description %}
<meta name="twitter:description" content="{{ page_description | escape }}">
{%- endif %}
{%- if template.name == 'product' %}
<meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
{%- if template.name == 'index' %}
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":{{ shop.url | append: '/#organization' | json }},"name":{{ shop.name | json }},"url":{{ shop.url | append: '/' | json }},"logo":{{ 'apple-touch-icon.png' | asset_url | prepend: 'https:' | json }},"email":"hello@velvetlengths.uk","description":"Remy human hair extensions and fitting accessories, with free tracked UK delivery."},{"@type":"WebSite","@id":{{ shop.url | append: '/#website' | json }},"name":{{ shop.name | json }},"url":{{ shop.url | append: '/' | json }},"inLanguage":"en-GB","publisher":{"@id":{{ shop.url | append: '/#organization' | json }}}}]}</script>
{%- endif %}
