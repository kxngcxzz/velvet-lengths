<section class="wrap" id="shop" aria-labelledby="t-best-{{ section.id }}">
  <div class="head">
    <h2 id="t-best-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.collection != blank -%}<a href="{{ section.settings.collection.url }}">Shop all</a>{%- endif -%}
  </div>
  {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
    <div class="grid">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="colour-name">Choose a collection with products in the theme editor.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hair extensions" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
