<section class="wrap" id="faq" aria-labelledby="t-faq">
  <div class="head"><h2 id="t-faq">{{ section.settings.heading | escape }}</h2></div>
  <div class="faq">
    {%- for block in section.blocks -%}
      <details{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="faq-answer">{{ block.settings.answer }}</div></details>
    {%- endfor -%}
  </div>
</section>
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {%- for block in section.blocks -%}
      {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]}</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "FAQs", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
