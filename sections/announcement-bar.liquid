{%- if section.settings.text != blank -%}
  <div class="announce">{{ section.settings.text | escape }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free tracked UK delivery on every order" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
