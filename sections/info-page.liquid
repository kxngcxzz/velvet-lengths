<div class="wrap page">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
  {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}
  {{ section.settings.body }}
</div>

{% schema %}
{
  "name": "Information page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "html", "id": "body", "label": "Content" }
  ]
}
{% endschema %}
