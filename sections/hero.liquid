{%- assign tag_product = section.settings.tag_product -%}
<div class="wrap hero">
  <div>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    <div class="ctas">
      {%- if section.settings.cta_label != blank -%}<a class="btn" href="{{ section.settings.cta_link | default: '#shop' }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
      {%- if section.settings.cta2_label != blank -%}<a class="btn ghost" href="{{ section.settings.cta2_link | default: '#guide' }}">{{ section.settings.cta2_label | escape }}</a>{%- endif -%}
    </div>
  </div>
  <div class="hero-art">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '550, 825, 1100', sizes: '(min-width: 860px) 45vw, 100vw', alt: section.settings.image_alt }}
    {%- else -%}
      <img src="{{ 'nano-ring-760.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1000" height="1000" fetchpriority="high">
    {%- endif -%}
    {%- if tag_product != blank -%}
      <a class="tag" href="{{ tag_product.url }}"><div>{{ tag_product.title | escape }}<span>{{ section.settings.tag_text | escape }}</span></div><b id="heroPrice">from {{ tag_product.price_min | money }}</b></a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Remy human hair extensions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Nano ring, tape-in and keratin U-tip extensions in up to 19 shades and 12 to 24 inches, plus the tools to fit them. Free tracked delivery on every UK order." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop extensions" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta2_label", "label": "Second button label", "default": "Length guide" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Nano ring tip extensions in honey brown highlights" },
    { "type": "product", "id": "tag_product", "label": "Product shown on the photo" },
    { "type": "text", "id": "tag_text", "label": "Small text under the product name", "default": "Shade 760 · 14–24 inches" }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
