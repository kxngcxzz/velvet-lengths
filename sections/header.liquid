{%- liquid
  assign ext = collections['hair-extensions']
  assign acc = collections['accessories']
  assign delivery_url = '/pages/delivery'
  assign returns_url = '/pages/returns'
  assign contact_url = '/pages/contact'
  assign guide_url = routes.root_url | append: '#guide'
  assign faq_url = routes.root_url | append: '#faq'
-%}
<header>
  <div class="wrap bar">
    <button class="vl-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="vl-menu"><span></span></button>
    <a class="logo" href="{{ routes.root_url }}" style="display:flex;align-items:center;gap:10px">{% render 'logo-mark', size: 40 %}<span>Velvet Lengths<small>HUMAN HAIR EXTENSIONS</small></span></a>
    <nav class="vl-nav" aria-label="Main">
      {%- if ext.products_count > 0 -%}
        <div class="vl-dd"><button type="button" aria-expanded="false" aria-haspopup="true">Hair Extensions</button><div class="vl-menu">
          {%- render 'ordered-products', coll: ext, mode: 'menu' -%}
          <hr><a href="{{ ext.url }}"{% if request.path == ext.url %} aria-current="page"{% endif %}>Shop all hair extensions</a>
        </div></div>
      {%- else -%}
        <a href="{{ routes.collections_url }}/hair-extensions">Hair Extensions</a>
      {%- endif -%}
      {%- if acc.products_count > 0 -%}
        <div class="vl-dd"><button type="button" aria-expanded="false" aria-haspopup="true">Accessories</button><div class="vl-menu">
          {%- render 'ordered-products', coll: acc, mode: 'menu' -%}
          <hr><a href="{{ acc.url }}"{% if request.path == acc.url %} aria-current="page"{% endif %}>Shop all accessories</a>
        </div></div>
      {%- else -%}
        <a href="{{ routes.collections_url }}/accessories">Accessories</a>
      {%- endif -%}
      <a href="{{ guide_url }}">Length guide</a>
      <div class="vl-dd"><button type="button" aria-expanded="false" aria-haspopup="true">Help</button><div class="vl-menu">
        <a href="{{ delivery_url }}"{% if request.path == delivery_url %} aria-current="page"{% endif %}>Delivery</a>
        <a href="{{ returns_url }}"{% if request.path == returns_url %} aria-current="page"{% endif %}>Returns</a>
        <a href="{{ faq_url }}">FAQs</a>
        <a href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact us</a>
      </div></div>
    </nav>
    <div class="icons">
      <button type="button" class="vl-theme" role="switch" aria-label="Dark mode" aria-checked="false">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="cart" id="cartBtn" type="button" aria-label="Cart">Bag <b id="cartCount">{{ cart.item_count }}</b></button>
    </div>
  </div>
</header>

<div class="vl-drawer" id="vl-menu" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="vl-dhead">
    <a class="vl-dlogo" href="{{ routes.root_url }}">{% render 'logo-mark' %}Velvet Lengths</a>
    <button class="vl-x" type="button" aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </div>
  <nav aria-label="Menu">
    {%- if ext.products_count > 0 -%}
      <button class="vl-row" type="button" aria-expanded="false" aria-controls="vl-extensions">Hair Extensions<span class="vl-chev"></span></button>
      <div class="vl-sub" id="vl-extensions" hidden>
        {%- render 'ordered-products', coll: ext, mode: 'drawer' -%}
        <a class="vl-all" href="{{ ext.url }}"{% if request.path == ext.url %} aria-current="page"{% endif %}>Shop all hair extensions</a>
      </div>
    {%- endif -%}
    {%- if acc.products_count > 0 -%}
      <button class="vl-row" type="button" aria-expanded="false" aria-controls="vl-accessories">Accessories<span class="vl-chev"></span></button>
      <div class="vl-sub" id="vl-accessories" hidden>
        {%- render 'ordered-products', coll: acc, mode: 'drawer' -%}
        <a class="vl-all" href="{{ acc.url }}"{% if request.path == acc.url %} aria-current="page"{% endif %}>Shop all accessories</a>
      </div>
    {%- endif -%}
    <a class="vl-row" href="{{ guide_url }}">Length guide</a>
    <button class="vl-row" type="button" aria-expanded="false" aria-controls="vl-help">Help<span class="vl-chev"></span></button>
    <div class="vl-sub" id="vl-help" hidden>
      <a href="{{ delivery_url }}"{% if request.path == delivery_url %} aria-current="page"{% endif %}>Delivery</a>
      <a href="{{ returns_url }}"{% if request.path == returns_url %} aria-current="page"{% endif %}>Returns</a>
      <a href="{{ faq_url }}">FAQs</a>
      <a href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact us</a>
    </div>
  </nav>
  <div class="vl-dfoot">
    <div class="vl-dlinks">
      <a href="{{ contact_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>Contact</a><button type="button" class="vl-bag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>Bag <span class="vl-count"></span></button>
    </div>
    <p class="vl-note">Free tracked UK delivery on every order</p>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "vl-sticky",
  "settings": [],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
