<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="{{ routes.root_url }}" style="display:flex;align-items:center;gap:10px">
      <svg viewBox="0 0 120 120" width="40" height="40" style="color:var(--accent);flex:none" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="60" cy="60" r="56" stroke-width="2.4"/><path d="M30 26 C38 40 34 52 44 66 C52 78 56 86 60 96M90 26 C82 40 86 52 76 66 C68 78 64 86 60 96" stroke-width="5"/><path d="M36 24 C44 40 42 54 51 68 C56 77 58 84 60 92M84 24 C76 40 78 54 69 68 C64 77 62 84 60 92" stroke-width="2" opacity=".7"/></g></svg>
      <span>Velvet Lengths<small>HUMAN HAIR EXTENSIONS</small></span>
    </a>
    <nav aria-label="Main">
      {%- if section.settings.use_menu and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/products/nano-ring-hair-extensions">Nano Ring</a>
        <a href="/products/tape-in-hair-extensions">Tape-In</a>
        <a href="/products/u-tip-hair-extensions">U-Tip</a>
        <a href="{{ routes.collections_url }}/accessories">Accessories</a>
        <a href="/#guide">Length Guide</a>
        <a href="/pages/contact">Contact</a>
      {%- endif -%}
    </nav>
    <div class="icons">
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Bag, {{ cart.item_count }} items">Bag <b>{{ cart.item_count }}</b></a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "use_menu", "label": "Use a Shopify menu instead of the built-in links", "default": false },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
