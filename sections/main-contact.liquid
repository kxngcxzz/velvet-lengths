<div class="wrap page">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
  {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}

  {%- form 'contact', class: 'cform' -%}
    {%- if form.posted_successfully? -%}
      <p role="status" style="margin:0"><b>Thanks, we've got your message.</b> We'll reply by email soon.</p>
    {%- endif -%}
    {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="cName">Name<input id="cName" name="contact[name]" required autocomplete="name" value="{{ form.name }}"></label>
    <label for="cEmail">Email<input id="cEmail" name="contact[email]" type="email" required autocomplete="email" value="{{ form.email }}"></label>
    <label for="cTopic">What's it about?
      <select id="cTopic" name="contact[topic]">
        <option>An order I've placed</option>
        <option>Help choosing a colour or length</option>
        <option>Returns or refunds</option>
        <option>Something else</option>
      </select>
    </label>
    <label for="cOrder">Order number (if you have one)<input id="cOrder" name="contact[order]"></label>
    <label for="cMsg">Message<textarea id="cMsg" name="contact[body]" required>{{ form.body }}</textarea></label>
    <button class="btn" type="submit">Send message</button>
  {%- endform -%}

  {{ section.settings.after }}
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lead", "label": "Introduction" },
    { "type": "html", "id": "after", "label": "Content below the form" }
  ]
}
{% endschema %}
