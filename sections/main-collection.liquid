<section class="wrap" aria-labelledby="CollectionHeading">
  <div class="head">
    <div>
      <p class="eyebrow">Shop</p>
      <h1 id="CollectionHeading" style="font-size:clamp(40px,6vw,64px)">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<p style="color:var(--muted);max-width:60ch">{{ collection.description | strip_html }}</p>{%- endif -%}
    </div>
  </div>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous %}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{% endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next %}<a href="{{ paginate.next.url }}">Next &rarr;</a>{% endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="colour-name">No products in this collection yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": []
}
{% endschema %}
