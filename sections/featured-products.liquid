<section class="wrap" id="shop" aria-labelledby="t-best">
  <div class="head"><h2 id="t-best">{{ section.settings.heading | escape }}</h2><a href="{{ routes.collections_url }}/hair-extensions">Shop all</a></div>
  <div class="grid" id="grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        {%- liquid
          assign start = product.selected_or_first_available_variant
          if block.settings.shade != blank
            for v in product.variants
              assign code = v.option1 | split: ' ' | first
              if code == block.settings.shade
                assign start = v
                break
              endif
            endfor
          endif
          assign start_img = start.featured_image | default: product.featured_image
        -%}
        <article class="card" data-card data-handle="{{ product.handle }}" data-shade="{{ block.settings.shade | escape }}" {{ block.shopify_attributes }}>
          <div class="media">
            <a href="{{ product.url }}">
              {%- if start_img -%}
                <img class="card-img" loading="lazy" decoding="async" src="{{ start_img | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800">
              {%- endif -%}
            </a>
            <button class="btn quick" type="button">Add to bag</button>
          </div>
          <h3>{{ product.title | escape }}</h3>
          <div class="swatches-row" role="group" aria-label="Colour"></div><div class="colour-name"></div>
          <div class="lengths" role="group" aria-label="Length"></div>
          <div class="meta"><span class="price">{{ start.price | money }}</span></div>
          <script type="application/json" data-card-json>{"title":{{ product.title | json }},"options":{{ product.options | json }},"variants":[
            {%- for v in product.variants -%}
              {"id":{{ v.id }},"price":{{ v.price }},"available":{{ v.available | json }},"options":{{ v.options | json }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]}</script>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hair extensions" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "shade", "label": "Shade shown first", "info": "The shade code, for example 760 or P18/613. Leave empty for the first shade." }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "Featured products", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
