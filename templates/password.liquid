<div class="wrap page" style="text-align:center;padding-block:96px">
  <h1>{{ shop.name }}</h1>
  <p class="lead" style="margin-inline:auto">{% if shop.password_message != blank %}{{ shop.password_message }}{% else %}Opening soon.{% endif %}</p>
  {%- form 'storefront_password', class: 'cform', style: 'margin:0 auto' -%}
    {{ form.errors | default_errors }}
    <label for="Password">Password<input type="password" name="password" id="Password" autocomplete="current-password"></label>
    <button class="btn" type="submit">Enter</button>
  {%- endform -%}
</div>
